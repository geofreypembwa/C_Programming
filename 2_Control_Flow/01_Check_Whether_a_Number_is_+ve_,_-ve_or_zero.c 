//The program that checks the number whether is positive, negative or zero 

#include <stdio.h>

int main() {
    int num;

    // Take input from user
    printf("Enter a number: ");
    scanf("%d", &num);

    // ===== Method 1: If-Else =====
    // Check the number using normal conditions
    if (num == 0) {
        printf("If-Else Method: Zero\n");
    }
    else if (num < 0) {
        printf("If-Else Method: Negative\n");
    }
    else {
        printf("If-Else Method: Positive\n");
    }

    // ===== Method 2: Bitwise =====
    // Check zero separately
    if (num == 0) {
        printf("Bitwise Method: Zero\n");
    } 
    else {
        // Create a mask with only the sign bit (MSB)
        int msb = num & (1 << (sizeof(int) * 8 - 1));

        // If MSB is 1 → Negative, else Positive
        if (msb)
            printf("Bitwise Method: Negative\n");
        else
            printf("Bitwise Method: Positive\n");
    }

    return 0;
}